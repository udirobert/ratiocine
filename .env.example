# Copy to .env and fill in real values.
# .env is gitignored — never commit real tokens.

# Hugging Face access token (https://huggingface.co/settings/tokens)
# Needs at least: read access for pulling base models, write access for pushing your submission repo.
HF_TOKEN=hf_your_token_here

# Model to fine-tune (Qwen2.5-7B or 3B recommended for T4 16GB)
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Local path to the training JSONL
DATASET_PATH=data/synthetic/iol_train.jsonl

# Where to save checkpoints locally
OUTPUT_DIR=./models/ratiocine-qwen

# Target HF repo for the submission (e.g. your-username/ratiocine)
HF_REPO_ID=

# Arkor live endpoint (Dashboard > ratiocine > Settings)
# NOTE: preview endpoints expire without notice (2026-10: 404 "Unknown
# preview" on every model). scripts/llm_providers.py fails over to the free
# lanes below, so a dead Arkor key no longer blocks evaluation runs.
ARKOR_API_KEY=
ARKOR_ENDPOINT_URL=https://rationcine.arkor.app/v1/chat/completions

# ── Inference lanes (OpenAI-compatible; any one is enough) ─────────────────
# Sign up free, no card. scripts/llm_providers.py tries arkor -> openrouter ->
# groq -> featherless -> google in order; 429/5xx are retried before failing over.
# Featherless is the funded lane (per-token pricing, ~$0.65/M in for
# Llama-3.3-70B), so it is tried last and pinned with --provider featherless
# when a sweep needs more than the free tiers can deliver.
# Probe health: python3 scripts/llm_providers.py --model google/gemma-4-31b-it
# Free-tier model IDs differ per provider — check each console's model list.
OPENROUTER_API_KEY=
GROQ_API_KEY=
FEATHERLESS_API_KEY=
GOOGLE_API_KEY=
# Optional URL overrides if a provider base path changes (without /chat/completions)
# OPENROUTER_URL=https://openrouter.ai/api/v1
# GROQ_URL=https://api.groq.com/openai/v1
# FEATHERLESS_URL=https://api.featherless.ai/v1
# GOOGLE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Solver trace logging (Phase 1 research) ─────────────────────────────────
# Salt for hashing session IDs server-side (generate a random 32-char string)
# This prevents re-identification of users across sessions
TRACE_SALT=generate-a-random-32-char-string-here

# Vercel Blob storage for consented solver traces (set in Vercel project
# settings — create a Blob store in the Vercel dashboard and it is injected).
# Without it, /api/log-trace accepts events but stores them nowhere.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── Ration attestation relay (showcase /api/attest → Neutron canister) ──────
# Server-side only. Set these in Vercel project settings (not in .env).
#
# The blast secret used to deploy the canister; identity 0 (the deployer) is
# derived deterministically from it and is the only principal the kernel
# authorizes for attest_entry. Local file: ~/Library/Application Support/blast/secret
RATION_DEPLOYER_SECRET=
#
# Optional shared token; when set, /api/attest requires
# `Authorization: Bearer <token>` from the browser client.
RATION_ATTEST_TOKEN=
#
# Mainnet Neutron canister holding the Ration app (ratiocine ledger).
# Hardcoded in showcase/app/api/attest/route.ts; change there if redeployed.
# CANISTER_ID=cvrwv-mqaaa-aaaai-ax4pa-cai

{
  "format": 3,
  "name": "Ration",
  "id": "ratiocine",
  "version": 200,
  "update_source": "233tv-xiaaa-aaaay-aacta-cai",
  "description": "Ration: a certified reasoning logbook. Solves Linguini problems via a declared outcall, grades answers in-canister (EM + chrF), and signs every entry with a chain-key assertion.",
  "src": "main.mo",
  "capabilities": {
    "https_outcalls": {
      "api": 1,
      "endpoints": [
        {
          "id": "solver",
          "url_prefix": "https://ratiocine.trustfall.xyz/api/",
          "methods": [
            "post"
          ],
          "request_headers": [
            "content-type"
          ],
          "max_request_bytes": 65536,
          "max_response_bytes": 131072,
          "transform": "strip_headers"
        }
      ]
    },
    "chain_key_signing": {
      "api": 1,
      "slots": [
        {
          "id": "ration_assertions",
          "algorithm": "ecdsa_secp256k1",
          "purpose": "Sign Ration reasoning-ledger assertions",
          "max_assertion_bytes": 4096
        }
      ]
    },
    "certified_assets": {
      "api": 2,
      "max_entries": 256,
      "max_committed_bytes": 1048576,
      "max_object_bytes": 65536,
      "max_pending_stages": 1,
      "max_staged_bytes": 65536,
      "max_batch_operations": 4,
      "max_batch_bytes": 65536,
      "max_idempotency_receipts": 64,
      "collections": [
        {
          "id": "ledger_report",
          "mount": "protocol",
          "kind": "immutable_blob",
          "path_prefix": "/v1/ledger/report/",
          "max_object_bytes": 65536
        }
      ]
    },
    "agent_entrypoints": {
      "api": 1,
      "entrypoints": [
        "ration_attest",
        "ration_ledger",
        "ration_report"
      ]
    }
  },
  "backend": {
    "capabilities": {
      "https_outcalls": {
        "api": 1
      },
      "chain_key_signing": {
        "api": 1
      },
      "certified_assets": {
        "api": 2
      }
    }
  },
  "tiles": [
    {
      "id": "main",
      "title": "Ration",
      "path": "index.html",
      "icon": "static/icon.png"
    }
  ],
  "func": {
    "attest_entry": {
      "type": "update",
      "async": "async*"
    },
    "get_ledger": {
      "type": "update",
      "async": "async*"
    },
    "publish_report": {
      "type": "update",
      "async": "async*"
    },
    "ping_solver": {
      "type": "update",
      "async": "async*"
    },
    "sign_probe": {
      "type": "update",
      "async": "async*"
    },
    "get_pubkey": {
      "type": "update",
      "async": "async*"
    }
  },
  "memory": {
    "ratiocine": {
      "version": 2,
      "schemas": {
        "1": {
          "src": "memory/ratiocine/v1.mo"
        },
        "2": {
          "src": "memory/ratiocine/v2.mo"
        }
      },
      "migrations": [
        {
          "from": 1,
          "to": 2,
          "src": "memory/ratiocine/v1_to_v2.mo"
        }
      ]
    }
  },
  "background": {
    "path": "service.html",
    "description": "Ration certified reasoning logbook"
  }
}
